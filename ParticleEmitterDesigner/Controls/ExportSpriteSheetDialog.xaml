<Window x:Class="ParticleEmitterDesigner.Controls.ExportSpriteSheetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Export Sprite Sheet"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}"
        d:DesignHeight="220" d:DesignWidth="320">
    <StackPanel Margin="16,14">
        <TextBlock Text="Grid Size" Style="{StaticResource GroupHeader}" Margin="0,0,0,4" />
        <ComboBox x:Name="GridCombo" VerticalContentAlignment="Center" Height="30">
            <ComboBoxItem Content="8 x 8 (64 frames, 2048px)" Tag="8" IsSelected="True" />
            <ComboBoxItem Content="4 x 4 (16 frames)" Tag="4" />
        </ComboBox>

        <TextBlock Text="Total Duration (seconds)" Style="{StaticResource GroupHeader}" Margin="0,10,0,4" />
        <TextBox x:Name="DurationBox" Text="1.0" Height="28" Padding="6,4"
                 Foreground="{StaticResource TextPrimary}" Background="#272B38"
                 BorderBrush="{StaticResource PanelBorder}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" />
            <Button Content="Export&#x2026;" IsDefault="True" Click="OnExportClick"
                    Margin="6,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>