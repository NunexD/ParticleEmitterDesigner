<UserControl x:Class="ParticleEmitterDesigner.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="34" d:DesignWidth="260">
    <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Swatch" Grid.Column="0"
                Width="22" Height="22" CornerRadius="3" Margin="0,0,8,0"
                BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                Background="#FFFFFF" />

        <TextBox x:Name="HexBox" Grid.Column="1"
                 Height="26" VerticalContentAlignment="Center"
                 FontFamily="Consolas"
                 LostFocus="OnHexLostFocus" KeyDown="OnHexKeyDown" />

        <StackPanel Grid.Column="2" Orientation="Horizontal"
                    Margin="8,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="A" VerticalAlignment="Center" Margin="0,0,4,0"
                       Foreground="{StaticResource TextSecondary}" />
            <Slider x:Name="AlphaSlider" Width="72" Minimum="0" Maximum="255"
                    VerticalAlignment="Center" ValueChanged="OnAlphaChanged" />
            <TextBlock x:Name="AlphaLabel" Width="30" TextAlignment="Right"
                       VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{StaticResource TextPrimary}" />
        </StackPanel>
    </Grid>
</UserControl>
