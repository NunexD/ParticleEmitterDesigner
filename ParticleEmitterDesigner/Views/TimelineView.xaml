<UserControl x:Class="ParticleEmitterDesigner.Views.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="720">
    <DockPanel Margin="10,8">

        <!-- Playback controls -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Play" Command="{Binding Shell.ActiveDocument.PlayCommand}" />
            <Button Content="Pause" Command="{Binding Shell.ActiveDocument.PauseCommand}" />
            <Button Content="Reset" Command="{Binding Shell.ActiveDocument.ResetCommand}" />
            <Button Content="Burst" Command="{Binding Shell.ActiveDocument.BurstCommand}" />
            <TextBlock Text="{Binding Shell.ActiveDocument.Title, StringFormat=Editing: {0}}"
                       Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Keyframe actions -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add Keyframe" Command="{Binding AddKeyframeCommand}" />
            <Button Content="Remove Keyframe" Command="{Binding RemoveKeyframeCommand}" />
            <TextBlock Text="Duration (s)" Foreground="{StaticResource TextSecondary}"
                       VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox Text="{Binding DurationSeconds}" Width="60" Height="26" Padding="6,2"
                     Foreground="{StaticResource TextPrimary}" Background="#272B38"
                     BorderBrush="{StaticResource PanelBorder}" VerticalContentAlignment="Center" />
            <TextBlock Text="{Binding Playhead, StringFormat=Playhead: {0:0.00}s}"
                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="16,0,0,0" />
        </StackPanel>

        <!-- Ruler + keyframes -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Slider Grid.Row="0" Minimum="0" Maximum="{Binding DurationSeconds}"
                    Value="{Binding Playhead}" VerticalAlignment="Center" />

            <Border Grid.Row="1" Height="18" Background="#12141B" CornerRadius="3"
                    BorderBrush="{StaticResource PanelBorder}" BorderThickness="1"
                    Margin="0,6,0,6">
                <ItemsControl ItemsSource="{Binding Keyframes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Accent}" Width="3" Height="16"
                                    CornerRadius="1" Margin="4,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Keyframes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat=Key @ {0:0.00}s}"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="Consolas" FontSize="11" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</UserControl>
